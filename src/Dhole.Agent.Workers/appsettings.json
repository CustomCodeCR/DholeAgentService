{
  "Postgres": {
    "ConnectionString": "Host=localhost;Port=5432;Database=dhole_agent;Username=postgres;Password=postgres"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "Streams": {
      "DefaultStreamName": "dhole.agent.events",
      "Consumer": {
        "StreamName": "dhole.agent.events",
        "ConsumerGroup": "dhole-agent",
        "ConsumerName": "dhole-agent-worker",
        "PollingIntervalSeconds": 2,
        "ReadPendingMessages": true
      },
      "Publisher": {
        "MaxLength": 10000
      },
      "Destinations": {
        "agent.execution.requested": "dhole.agent.events",
        "agent.execution.started": "dhole.agent.events",
        "agent.execution.completed": "dhole.agent.events",
        "agent.execution.failed": "dhole.agent.events",
        "agent.ocean-freight-rates.extracted": "dhole.pricing.events",
        "agent.browser-session.expired": "dhole.agent.events",
        "audit.event.registered": "dhole.audit.events",
        "notifications.notification.requested": "dhole.notifications.events"
      }
    }
  },
  "Messaging": {
    "SourceService": "DholeAgentService"
  },
  "Workers": {
    "Enabled": true,
    "MaxRetryCount": 3,
    "RetryDelaySeconds": 5,
    "UseDistributedLock": true,
    "LockDurationSeconds": 120,
    "Schedule": {
      "IntervalSeconds": 30,
      "RunImmediately": true
    }
  },
  "MaerskCircuit": {
    "Enabled": false,
    "TransientFailureThreshold": 3,
    "TechnicalCooldownSeconds": 900,
    "ProviderCooldownSeconds": 1800
  },
  "AgentQueue": {
    "ConcurrentDispatcherEnabled": false,
    "MaxConcurrentExecutions": 4,
    "MaxConcurrentMaersk": 1,
    "MaxConcurrentPerBrowserProfile": 1,
    "PollIntervalSeconds": 1,
    "LeaseSeconds": 180,
    "HeartbeatSeconds": 20,
    "MaxExecutionSeconds": 3600,
    "MaxTransientRetries": 2,
    "RetryBackoffSeconds": [15, 60]
  },
  "Browser": {
    "ProfilesPath": "/data/browser-profiles",
    "Headless": true,
    "DefaultTimeoutMs": 60000
  },
  "Hermes": {
    "BaseUrl": "http://hermes-agent:8642",
    "ExecutePath": "/v1/chat/completions",
    "Model": "hermes-agent",
    "ApiKey": "",
    "TimeoutSeconds": 600,
    "TaskTimeoutSeconds": 300,
    "MaxParallelTasks": 2
  }
}
